{
  "info": {
    "name": "Psychometrics - Doctor Owner and Patient Assessments",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Apply V031. Doctor or platform owner: login using the corresponding request; browser_token is saved automatically. Set tenant_code and login credentials. Doctor needs ASSESSMENT_ASSIGN permission. Both roles can browse draft content and scores. Patient: login separately, list own assignments, then read assigned questions. Patient content requires published assessment/version, ASSIGNED/IN_PROGRESS status, unexpired assignment and ACTIVE assessment_access with verified payment/consent. Scoring keys are not returned to patients. Assignment creation uses doctor_token and the existing /data API; pending payment assignments do not immediately unlock content. Set patient_id, doctor_id, assessment_id and version_id before assigning. Clear secrets before sharing collection exports."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{browser_token}}",
        "type": "string"
      }
    ]
  },
