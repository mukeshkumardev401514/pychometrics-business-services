            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"patient_token\");",
                  "pm.test(\"Login role\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().role).to.eql(\"PATIENT\"); });",
                  "if (pm.response.code === 200 && pm.response.json().role === \"PATIENT\") {",
                  "pm.collectionVariables.set(\"patient_token\", pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
