  "item": [
    {
      "name": "1 Authentication",
      "item": [
        {
          "name": "Doctor login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{doctor_email}}\",\n  \"password\": \"{{doctor_password}}\",\n  \"tenant_code\": \"{{tenant_code}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"doctor_token\");",
                  "pm.collectionVariables.unset(\"browser_token\");",
                  "pm.test(\"Login role\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().role).to.eql(\"DOCTOR\"); });",
                  "if (pm.response.code === 200 && pm.response.json().role === \"DOCTOR\") {",
                  "pm.collectionVariables.set(\"doctor_token\", pm.response.json().access_token);",
                  "pm.collectionVariables.set(\"browser_token\", pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Platform owner login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/platform/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"owner_token\");",
                  "pm.collectionVariables.unset(\"browser_token\");",
                  "pm.test(\"Login role\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().role).to.eql(\"PLATFORM_ADMIN\"); });",
                  "if (pm.response.code === 200 && pm.response.json().role === \"PLATFORM_ADMIN\") {",
                  "pm.collectionVariables.set(\"owner_token\", pm.response.json().access_token);",
                  "pm.collectionVariables.set(\"browser_token\", pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Patient login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [
