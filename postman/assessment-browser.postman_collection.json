    {
      "name": "3 Doctor assigns assessment",
      "item": [
        {
          "name": "Assign assessment to linked patient",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/data/assessment-assignments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{doctor_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": \"{{doctor_id}}\",\n  \"patient_id\": \"{{patient_id}}\",\n  \"assessment_id\": \"{{assessment_id}}\",\n  \"assessment_version_id\": \"{{version_id}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"assignment_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 Patient assigned content",
      "item": [
        {
          "name": "My assessment assignments",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/patient/assessments?limit={{limit}}&offset={{offset}}",
            "header": [],
            "auth": {
